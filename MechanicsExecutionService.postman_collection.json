{
  "info": {
    "name": "Mechanics Execution Service API (Fase 4)",
    "description": "API collection for the Execution Service microservice (Execution Queue, Diagnosis, Repair Notes & Completion/Failure) — FIAP POS Tech 15SOAT Fase 4.\n\n**Token:** the Execution Service has no login. Put a staff JWT in the `token` variable, from mechanics-software (`POST /api/auth/login`, `admin@mechanics.local` / `Admin@123` in Development). Every route except `/health` is staff only; a customer token gets `403`.\n\n**Where orders come from:** there is no create route. An execution order is created when the OS Service sends `EnqueueExecution` after the payment is confirmed. Run the OS and Billing flow first (or publish `EnqueueExecution` from the RabbitMQ management UI).\n\n**Order:** run List Execution Queue (saves `executionId` from the first entry), then Start Diagnosis, Add Execution Note, and finally Complete Execution or Fail Execution. Notes, Complete and Fail only work while the order is `IN_PROGRESS`; Complete and Fail are alternatives, so pick one per order. Start Diagnosis removes the order from the queue, so keep `executionId` for the requests after it.\n\n**Deployed:** set `baseUrl` to the API Gateway URL; `/api/executions` is routed to this service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "executionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Executions",
      "item": [
        {
          "name": "List Execution Queue (Ordered by Priority & Arrival)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const list = pm.response.json();",
                  "    if (Array.isArray(list) && list.length > 0) {",
                  "        pm.collectionVariables.set('executionId', list[0].executionOrderId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Orders still waiting (`QUEUED`), read from the MongoDB projection. Saves the first `executionOrderId` as `executionId`.",
            "url": {
              "raw": "{{baseUrl}}/api/executions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions"]
            }
          }
        },
        {
          "name": "Get Execution by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}"]
            }
          }
        },
        {
          "name": "Start Diagnosis",
          "request": {
            "method": "POST",
            "description": "`QUEUED` → `IN_PROGRESS`; removes the order from the queue.",
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}/start-diagnosis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}", "start-diagnosis"]
            }
          }
        },
        {
          "name": "Add Execution Note (MongoDB)",
          "request": {
            "method": "POST",
            "description": "Only while `IN_PROGRESS`. Returns `204`.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Diagnóstico concluído: substituição de filtro e óleo iniciada.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}", "notes"]
            }
          }
        },
        {
          "name": "Get Execution Notes (MongoDB)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}", "notes"]
            }
          }
        },
        {
          "name": "Complete Execution (Publishes ExecutionCompleted)",
          "request": {
            "method": "POST",
            "description": "`IN_PROGRESS` → `COMPLETED`; the OS Service moves the service order to `COMPLETED`.",
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}", "complete"]
            }
          }
        },
        {
          "name": "Fail Execution (Publishes ExecutionFailed -> Saga Compensation)",
          "request": {
            "method": "POST",
            "description": "`IN_PROGRESS` → `FAILED`; the OS Service cancels the service order, returns the parts to stock and sends `CancelBudget` so Billing refunds the payment.",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Trinca estrutural no bloco do motor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/executions/{{executionId}}/fail",
              "host": ["{{baseUrl}}"],
              "path": ["api", "executions", "{{executionId}}", "fail"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
